---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - ModDota API</title>
    <base href={base} />
    <link rel="icon" href={`${base}images/favicon.ico`} />
    <script is:inline>
      // Theme initialization - must run before body renders to prevent flash
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || (theme !== 'light' && !theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <div id="api-root" style="display:flex;flex-direction:column;height:100%;">
      <slot />
    </div>
  </body>
</html>

---
import ApiLayout from '../../../layouts/ApiLayout.astro';
import { ChangelogPage } from '../../../components/api/pages/ChangelogPage';
import changelogIndex from '@moddota/dota-data/files/changelog-index.json';

interface IndexEntry {
  version: string;
}

export function getStaticPaths() {
  const entries = changelogIndex as IndexEntry[];
  return [
    { params: { version: 'latest' } },
    ...entries.map(({ version }) => ({ params: { version } })),
  ];
}
---

<ApiLayout title="Changelog">
  <ChangelogPage client:load />
</ApiLayout>

{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "npm run lint:prettier",
    "lint:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "prebuild": "node -e \"const fs=require('fs');const p=require('path');const paths=['../dota-data','../../dota-data'];const dst=p.resolve(__dirname,'node_modules/@moddota/dota-data');for(const rel of paths){const src=p.resolve(__dirname,rel);if(fs.existsSync(src)){['files','lib'].forEach(d=>{const s=p.join(src,d),t=p.join(dst,d);if(fs.existsSync(s)){fs.cpSync(s,t,{recursive:true});console.log('Copied',d,'from',src)}});break;}}\""
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "all",
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "parser": "mdx",
          "printWidth": 100,
          "tabWidth": 2,
          "singleQuote": true
        }
      }
    ]
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.0.0",
    "@moddota/dota-data": "^0.45.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/lodash": "^4.14.165",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-virtualized": "^9.21.10",
    "astro": "^5.0.0",
    "lodash": "^4.17.20",
    "polished": "^4.0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-virtualized": "^9.22.2",
    "tailwindcss": "^4.0.0",
    "tiny-invariant": "^1.3.1",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "prettier": "^2.8.8",
    "typescript": "^5.0.4"
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 firefox version",
    "last 1 safari version"
  ]
}
